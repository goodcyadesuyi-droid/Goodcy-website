# Copy to .env.local for local development. Never commit real secrets.
WORKOS_CLIENT_ID=client_your_client_id
# Optional: AuthKit sign-in works in PKCE public-client mode without this key.
# Only add WORKOS_API_KEY on the server if you need WorkOS management APIs.
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=replace-with-a-random-secret-at-least-32-characters-long
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings for persistent demo accounts and trade history.
# The service-role key is server-only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Live market-data integration is intentionally not configured by default.
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
LIVE_TRADING_ENABLED=false
LIVE_OPTIONS_ENABLED=false

# Deriv OAuth 2.0 demo connection. Register this exact callback URL in Deriv.
DERIV_CLIENT_ID=your_deriv_oauth_app_id
APP_BASE_URL=https://your-deployed-domain.example
# Generate 32 random bytes and base64-encode them. Server-side only.
MFX_DERIV_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key
# Keep all real trading disabled.
LIVE_TRADING_ENABLED=false
LIVE_OPTIONS_ENABLED=false
