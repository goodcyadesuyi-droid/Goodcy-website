# Copy to .env.local for local development. Never commit real secrets.
WORKOS_CLIENT_ID=client_your_client_id
# Optional: AuthKit sign-in works in PKCE public-client mode without this key.
# Only add WORKOS_API_KEY on the server if you need WorkOS management APIs.
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=replace-with-a-random-secret-at-least-32-characters-long
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000
